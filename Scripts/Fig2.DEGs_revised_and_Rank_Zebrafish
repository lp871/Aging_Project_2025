Z_ambient_genes = Z_ambient_genes[order(Z_ambient_genes$Avg, decreasing = TRUE), ]
Z_ambient_genes_Top50 = Z_ambient_genes$Gene[which(Z_ambient_genes$Avg > 0.0025)]
Z_ambient_genes_Top50 = sapply(strsplit(Z_ambient_genes_Top50, split = "~~"), function(x) x[[2]])
k = grep("^mt-", rownames(Zebrafish_seurat_clcl))
if(length(k) > 0) Zebrafish_seurat_clcl = Zebrafish_seurat_clcl[-k, ]
k = which(rownames(Zebrafish_seurat_clcl) %in% Z_ambient_genes_Top50)
if(length(k) > 0) Zebrafish_seurat_clcl = Zebrafish_seurat_clcl[-k, ]
message(sprintf("Zebrafish_seurat_clcl: %d cells x %d genes; samples=%d",
                ncol(Zebrafish_seurat_clcl), nrow(Zebrafish_seurat_clcl),
                length(unique(Zebrafish_seurat_clcl$sample))))
print(table(Zebrafish_seurat_clcl$sample))

## 4) Pseudobulk function (use normalize=FALSE for edgeR)
getPseudoBulkByCellSample <- function(
  seurat_obj, assay_name = "RNA", layer_name = "counts",
  celltype_col = "celltype", sample_col = "sample", normalize = TRUE
) {
  counts <- Seurat::GetAssayData(seurat_obj, assay = assay_name, layer = layer_name)
  meta   <- seurat_obj@meta.data
  if (!inherits(counts, "dgCMatrix")) counts <- as(counts, "dgCMatrix")
  ct_levels <- c("MG","RGC","AC","HC","Cone","Rod","BC","Microglia","RPE")
  pb_list <- lapply(ct_levels, function(ct) {
    cells_ct <- rownames(meta)[meta[[celltype_col]] == ct]
    if (length(cells_ct) == 0) return(NULL)
    sub_counts <- counts[, cells_ct, drop = FALSE]
    sub_meta   <- meta[cells_ct, , drop = FALSE]
    grp_sample <- factor(sub_meta[[sample_col]], levels = sort(unique(sub_meta[[sample_col]])))
    design <- model.matrix(~0 + grp_sample)
    colnames(design) <- levels(grp_sample)
    Matrix(sub_counts %*% Matrix(design, sparse = TRUE), sparse = TRUE)
  })
  names(pb_list) <- ct_levels
  if (isTRUE(normalize)) stop("Only raw counts (normalize=FALSE) are needed here")
  pb_list
}

message("=== Loading complete; continue with edgeR / Rank (noKmeans) below ===")

######
###### edgeR: per-gene log2FC and p-value for Old vs Young (pseudobulk-based) ######
######

library(edgeR)

## Note: bulk_mat in Zebrafish_pseudo_count_input is log2-CPM (normalized) and cannot be passed to edgeR directly!
## edgeR requires raw integer counts, so regenerate a raw-count pseudobulk with normalize=FALSE
Zebrafish_pseudo_count_raw = getPseudoBulkByCellSample(Zebrafish_seurat_clcl, normalize = FALSE)

Zebrafish_pseudo_count_input_raw = list()
for(i in 1:length(Zebrafish_pseudo_count_raw)){
    tmp_mat = as.matrix(Zebrafish_pseudo_count_raw[[i]])
    tmp_age = as.numeric(sub("_Rep.*$", "", colnames(tmp_mat)))
    tmp_table = data.frame(sample = colnames(tmp_mat), age = tmp_age)
    Zebrafish_pseudo_count_input_raw[[i]] = list(bulk_mat = tmp_mat, bulk_meta = tmp_table)
}
names(Zebrafish_pseudo_count_input_raw) = names(Zebrafish_pseudo_count_raw)

## Input: Zebrafish_pseudo_count_input_raw[[ct]] = list(bulk_mat = gene x sample raw counts,
##                                                     bulk_meta = data.frame(sample, age))
## Group by age: age <= young_max -> Young; age >= old_min -> Old; intermediate time points are dropped
## Returns: data.frame(Gene, logFC, logCPM, F, PValue, FDR); logFC > 0 means higher in Old than Young
call_DEG_edgeR <- function(list_process, young_max = 6, old_min = 36, min_n = 2){
    bulk_mat  = as.matrix(list_process$bulk_mat)
    bulk_meta = list_process$bulk_meta
    stopifnot(identical(colnames(bulk_mat), as.character(bulk_meta$sample)))
    age = as.numeric(bulk_meta$age)
    ####### Grouping #######
    grp = rep(NA_character_, length(age))
    grp[age <= young_max] = "Young"
    grp[age >= old_min]   = "Old"
    keep_s = which(!is.na(grp))
    counts = round(bulk_mat[, keep_s, drop = FALSE])
    group  = factor(grp[keep_s], levels = c("Young","Old"))
    ####### Sample size check #######
    if(nlevels(droplevels(group)) < 2 || min(table(group)) < min_n){
        message("Insufficient samples, skipping: ", paste(names(table(group)), table(group), collapse=" ")); 
        return(NULL)
    }
    ####### edgeR QL pipeline #######
    y = DGEList(counts = counts, group = group)
    keep_g = filterByExpr(y, group = group)
    y = y[keep_g, , keep.lib.sizes = FALSE]
    y = calcNormFactors(y)
    design = model.matrix(~ group)            # second column = Old vs Young
    y = estimateDisp(y, design)
    fit = glmQLFit(y, design)
    qlf = glmQLFTest(fit, coef = 2)
    ####### Results #######
    res = topTags(qlf, n = Inf, sort.by = "PValue")$table
    res = data.frame(Gene = rownames(res), res, row.names = NULL)
    res$direction = ifelse(res$logFC > 0, "Up_Old", "Down_Old")
    return(res)
}

####### Run for each celltype (using raw counts) #######
Zebrafish_DEG_edgeR = list()
for(ct in names(Zebrafish_pseudo_count_input_raw)){
    message("==== ", ct, " ====")
    res = call_DEG_edgeR(Zebrafish_pseudo_count_input_raw[[ct]], young_max = 3, old_min = 36)
    if(is.null(res)) next
    n_up   = sum(res$PValue < 0.05 & res$logFC > 0)
    n_down = sum(res$PValue < 0.05 & res$logFC < 0)
    message(sprintf("%s: Up (higher in Old) = %d, Down (lower in Old) = %d (PValue<0.05)", ct, n_up, n_down))
    Zebrafish_DEG_edgeR[[ct]] = res
}

####### Save #######
setwd("/projects/hmz-aging/Zebrafish_New_Datasets")
save(Zebrafish_DEG_edgeR, file = "Zebrafish_DEG_edgeR")


######
###### Rank (consistent with Mouse / Human noKmeans): edgeR only, no intersection with k-means ######
###### metric = sign(logFC) * -log10(PValue); all edgeR genes are scored directly ######
###### Note: the old version set P = 1 for non-k-means genes -> rank ~ 0; with noKmeans, nonzero should be close to the total gene count ######
######
Build_Rank_from_DEG <- function(deg, eps = 1e-300){
    pv = deg$PValue; pv[is.na(pv)] = 1
    pv[pv < eps] = eps
    stat = sign(deg$logFC) * (-log10(pv))
    names(stat) = as.character(deg$Gene)
    ok = !is.na(stat) & is.finite(stat)
    stat = stat[ok]
    stat = tapply(stat, names(stat), function(x) x[which.max(abs(x))])
    sort(stat, decreasing = TRUE)
}

Zebrafish_DEG_rank = list()
for(ct in names(Zebrafish_DEG_edgeR)){
    deg = Zebrafish_DEG_edgeR[[ct]]
    Zebrafish_DEG_rank[[ct]] = Build_Rank_from_DEG(deg)
    n = length(Zebrafish_DEG_rank[[ct]])
    n_nz = sum(Zebrafish_DEG_rank[[ct]] != 0)
    pct_nz = 100 * n_nz / max(n, 1)
    message(sprintf("[noKmeans] %s: n=%d, nonzero=%d (%.1f%%); P<0.05 up=%d down=%d",
                    ct, n, n_nz, pct_nz,
                    sum(deg$PValue < 0.05 & deg$logFC > 0, na.rm = TRUE),
                    sum(deg$PValue < 0.05 & deg$logFC < 0, na.rm = TRUE)))
    ## Diagnostic: in the old k-means-zeroed version, nonzero is usually only hundreds/thousands and << n; noKmeans should be close to 100%
    if(pct_nz < 50){
        warning(sprintf("%s: nonzero is only %.1f%%, which looks like the old kmeans-overlap zeroed version! Make sure Build_Rank_from_DEG in this section was rerun",
                        ct, pct_nz))
    }
}

####### Save rank (new file name, so GSEA does not read the old version) #######
setwd("/projects/hmz-aging/Zebrafish_New_Datasets")
saveRDS(Zebrafish_DEG_rank, file = "Zebrafish_DEG_rank_noKmeans.rds")
## Also saved under the old file name for compatibility; content is noKmeans
save(Zebrafish_DEG_rank, file = "Zebrafish_DEG_rank")
message("Saved: Zebrafish_DEG_rank_noKmeans.rds")


#######
#######  Next, map the ranks to human genes #######
#######

######
###### Map zebrafish genes in Zebrafish_DEG_rank to human orthologs (for fgsea) ######
######

## HMZ_ortholog_combined = list(HM, HZ, MZ, HMZ); HZ = zebrafish->human (columns: human, zebrafish)
setwd("/projects/hmz-aging/Zebrafish_New_Datasets")
load("/projects/hmz-aging/Zebrafish_New_Datasets/HMZ_ortholog_combined")
HZ = unique(HMZ_ortholog_combined$HZ[, c("human", "zebrafish")])
HZ = HZ[HZ$human != "" & HZ$zebrafish != "", ]

## One zebrafish gene -> multiple human genes: keep all with the same weight (rank value) (expanded by merge)
## Multiple zebrafish genes -> one human gene: keep the one with the largest |stat| (fgsea requires unique gene names)
zf_rank_to_human <- function(rank_vec, HZ){
    df = data.frame(zebrafish = names(rank_vec), stat = as.numeric(rank_vec), stringsAsFactors = FALSE)
    mg = merge(df, HZ, by = "zebrafish")          # one-to-many: one row per pair, stat unchanged
    if(nrow(mg) == 0) return(numeric(0))
    stat = tapply(mg$stat, mg$human, function(x) x[which.max(abs(x))])
    stat = sort(stat, decreasing = TRUE)
    return(stat)
}

Zebrafish_DEG_rank_human = lapply(Zebrafish_DEG_rank, zf_rank_to_human, HZ = HZ)
names(Zebrafish_DEG_rank_human) = names(Zebrafish_DEG_rank)

## Compare gene counts before and after mapping
rank_sum = data.frame(
    celltype = names(Zebrafish_DEG_rank),
    zf       = sapply(Zebrafish_DEG_rank, length),
    zf_nonzero = sapply(Zebrafish_DEG_rank, function(x) sum(x != 0)),
    human    = sapply(Zebrafish_DEG_rank_human, length),
    human_nonzero = sapply(Zebrafish_DEG_rank_human, function(x) sum(x != 0))
)
print(rank_sum)
message(sprintf("Diagnostic: median zf nonzero fraction = %.1f%% (noKmeans should be close to 100%%; old k-means-zeroed version is usually <20%%)",
                100 * median(rank_sum$zf_nonzero / pmax(rank_sum$zf, 1))))

####### Save #######
setwd("/projects/hmz-aging/Zebrafish_New_Datasets")
saveRDS(Zebrafish_DEG_rank_human, file = "Zebrafish_DEG_rank_human.rds")
message("Saved: Zebrafish_DEG_rank_human.rds")


