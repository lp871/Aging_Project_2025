library(ComplexHeatmap)
library(circlize)
library(reshape2)

df = Zebrafish_GSEA_term_df
df$sig = df$pval < 0.05 & !is.na(df$pval)

## 1. Keep only terms significantly enriched in at least one celltype
sig_terms = unique(df$term_id[df$sig])
df_keep   = df[df$term_id %in% sig_terms, ]
message(sprintf("Terms significant in at least one celltype: %d", length(sig_terms)))

## 2. Build NES matrix (term x celltype) + significance matrix
nes_mat = acast(df_keep, term_id ~ celltype, value.var = "NES")
sig_mat = acast(df_keep, term_id ~ celltype, value.var = "sig")
sig_mat[is.na(sig_mat)] = FALSE
nes_mat[!sig_mat] = NA              # leave non-significant cells blank

## 3. Column (celltype) order
ct_levels = c("MG","RGC","AC","HC","BC","Cone","Rod","Microglia","RPE")
ct_levels = ct_levels[ct_levels %in% colnames(nes_mat)]
nes_mat   = nes_mat[, ct_levels, drop = FALSE]

## 4. Row annotation: category + readable pathway names; rows ordered numerically C1..C10
term_info = unique(df_keep[, c("term_id","gene_set","category")])
term_info = term_info[match(rownames(nes_mat), term_info$term_id), ]
term_info$cat_short = sub("^(C[0-9]+)_.*", "\\1", term_info$category)
term_info$cat_num   = as.numeric(sub("^C([0-9]+)_.*", "\\1", term_info$category))
ord = order(term_info$cat_num, rownames(nes_mat))
nes_mat   = nes_mat[ord, , drop = FALSE]
term_info = term_info[ord, ]
rownames(nes_mat) = term_info$gene_set       # use readable names as row names

## 5. Colors (NPG/Nature): NES blue-white-red; category color blocks
col_fun = colorRamp2(c(-2, 0, 2), c("#3C5488", "white", "#E64B35"))
npg_cols = c("#E64B35","#4DBBD5","#00A087","#3C5488","#F39B7F",
             "#8491B4","#91D1C2","#DC0000","#7E6148","#B09C85")
cats = unique(term_info$category[order(term_info$cat_num)])
cat_colors = setNames(npg_cols[seq_along(cats)], cats)

## Set Category as a factor (ordered C1..C10); one legend row per category
cat_factor = factor(term_info$category, levels = cats)
left_anno = rowAnnotation(
    Category = cat_factor,
    col = list(Category = cat_colors),
    show_annotation_name = FALSE,
    annotation_legend_param = list(Category = list(title = "Category", ncol = 1))
)

row_sp = factor(term_info$cat_short, levels = paste0("C", sort(unique(term_info$cat_num))))

## 6. Plot (height scales with the number of terms)
h_in = max(6, nrow(nes_mat) * 0.13 + 2)
ht = Heatmap(
    nes_mat, name = "NES", col = col_fun, na_col = "grey95",
    left_annotation = left_anno,
    row_split = row_sp, row_title_rot = 0, row_gap = unit(1, "mm"),
    cluster_rows = FALSE, cluster_columns = FALSE,
    show_row_names = TRUE, row_names_gp = gpar(fontsize = 5.5),
    show_column_names = TRUE, column_names_gp = gpar(fontsize = 11),
    column_names_rot = 45,
    rect_gp = gpar(col = "white", lwd = 0.5),
    border = TRUE,
    heatmap_legend_param = list(title = "NES", at = c(-2,-1,0,1,2), border = "black")
)

