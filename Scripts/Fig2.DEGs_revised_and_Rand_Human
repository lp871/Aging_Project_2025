Plot_dot <- function(Plot, Kmeans_order){
    library(reshape2)
    d = melt(Plot)
    d$class  = Kmeans_order$cluster[match(d$Var1, Kmeans_order$genes)]
    d$Var2_1 = as.numeric(factor(d$Var2, levels = colnames(Plot)))   # column order = age order
    cl_levels = seq_len(length(new_order))                           # consistent with new_order renumbering
    d$class  = factor(d$class, levels = cl_levels)
    d
}

