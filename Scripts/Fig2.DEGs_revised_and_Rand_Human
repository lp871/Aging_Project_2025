##########
########## We use human datasets (2026 clean5) ##########
########## clean5: X = raw counts; obs: sex, donor_id, sampleid, age, celltype
########## per-donor pseudobulk = raw counts summed by obs['donor_id']
########## sex is in obs['sex'] (male/female); usable as a covariate / for sex-stratified DEGs
##########

conda activate scvi-env
python

import scanpy as sc
import numpy as np
import pandas as pd
import scipy.sparse as sp
import scipy.io as sio
import os, re

h5ad_dir   = "/projects/hmz-aging/Human_New_Datasets/celltype_h5ad"
out_root   = "/projects/hmz-aging/Human_New_Datasets/pseudobulk_sample"
# 2026: use {ct}_clean5.h5ad (X = raw counts; unified columns: sex/donor_id/sampleid/age/celltype)
celltypes  = ['AC', 'BC', 'RGC', 'Rod', 'Cone', 'HC', 'MG', 'Microglia', 'RPE']
os.makedirs(out_root, exist_ok=True)

def check_raw_counts(X, name="X", n_check=200000):
    """Check whether the matrix looks like raw counts: non-negative + near-integer. Returns (is_raw, msg)."""
    if sp.issparse(X):
        d = X.data
        if d.size == 0:
            return False, f"{name}: empty matrix"
        if d.size > n_check:
            rng = np.random.default_rng(0)
            d = d[rng.choice(d.size, n_check, replace=False)]
    else:
        d = np.asarray(X).ravel()
        if d.size > n_check:
            rng = np.random.default_rng(0)
            d = d[rng.choice(d.size, n_check, replace=False)]
    d = d[np.isfinite(d)]
    if d.size == 0:
        return False, f"{name}: no valid values"
    mn, mx = float(d.min()), float(d.max())
    frac_nonneg = float(np.mean(d >= -1e-8))
    frac_int = float(np.mean(np.isclose(d, np.round(d), atol=1e-6)))
    is_raw = (frac_nonneg > 0.999) and (frac_int > 0.99) and (mx > 1)
    msg = (f"{name}: min={mn:.4f}, max={mx:.4f}, "
           f"frac_nonneg={frac_nonneg:.4f}, frac_near_int={frac_int:.4f}, likely_raw_counts={is_raw}")
    return is_raw, msg

def make_sample_pseudobulk(celltype, h5ad_dir=h5ad_dir, out_root=out_root):
    h5ad_file = os.path.join(h5ad_dir, f"{celltype}_clean5.h5ad")
    print(f"\n==== {celltype} ====")
    assert os.path.exists(h5ad_file), f"File not found: {h5ad_file}"
    adata = sc.read_h5ad(h5ad_file)
    print(f"  {adata.shape[0]} cells x {adata.shape[1]} genes")
    print(f"  obs columns: {adata.obs.columns.tolist()}")
    # clean5: adata.X = raw counts; check after loading
    is_raw, msg = check_raw_counts(adata.X, name="adata.X")
    print(f"  {msg}")
    if not is_raw:
        raise ValueError(f"{celltype}: adata.X does not look like raw counts, please check clean5!")
    counts = adata.X
    if not sp.issparse(counts):
        counts = sp.csr_matrix(counts)
    counts = counts.tocsr()
    #
    obs = adata.obs.copy()
    obs['sampleid'] = obs['sampleid'].astype(str)
    # age in clean5 may be "90 years" or numeric; convert to a parseable string
    obs['age'] = obs['age'].astype(str)
    # donor_id: the main atlas has real donors; if missing/all empty, fall back to sampleid
    if ('donor_id' not in obs.columns) or obs['donor_id'].isna().all():
        obs['donor_id'] = obs['sampleid']
    obs['donor_id'] = obs['donor_id'].astype(str)
    # Aggregate by donor (multiple samples from the same donor merged into one) to avoid pseudoreplication
    donor_ids = sorted(obs['donor_id'].unique().tolist())
    #
    # Sum by donor -> gene x donor
    pb = np.zeros((adata.shape[1], len(donor_ids)), dtype=np.float64)
    meta_rows = []
    for j, did in enumerate(donor_ids):
        idx = np.where((obs['donor_id'] == did).values)[0]
        pb[:, j] = np.asarray(counts[idx, :].sum(axis=0)).flatten()
        sub = obs.iloc[idx]
        age_str = str(sub['age'].iloc[0])
        m = re.search(r'(\d+)', age_str)             # "90 years" / "90" -> 90
        age_num = int(m.group(1)) if m else np.nan
        sex     = sub['sex'].mode().iloc[0] if 'sex' in sub else 'NA'
        n_samp  = sub['sampleid'].nunique()          # number of original samples merged for this donor
        meta_rows.append({'donor_id': did, 'donor_age': age_str, 'age': age_num,
                          'sex': sex, 'n_samples': n_samp, 'n_cells': len(idx)})
    meta = pd.DataFrame(meta_rows)
    #
    # Normalization: log2(CP10K + 1) (consistent with zebrafish/mouse; for trends/visualization)
    lib_sizes = pb.sum(axis=0)                          # library size of each sample
    lib_sizes[lib_sizes == 0] = 1                       # avoid division by zero
    cp10k = pb / lib_sizes * 1e4
    pb_norm = np.log2(cp10k + 1)
    #
    # Export: matrix_raw.mtx (raw counts, for edgeR) + matrix_norm.mtx (log2-CP10K) + genes.tsv + samples.tsv
    out_dir = os.path.join(out_root, celltype)
    os.makedirs(out_dir, exist_ok=True)
    sio.mmwrite(os.path.join(out_dir, "matrix_raw.mtx"),  sp.csr_matrix(pb))        # not normalized, for edgeR
    sio.mmwrite(os.path.join(out_dir, "matrix_norm.mtx"), sp.csr_matrix(pb_norm))   # log2-CP10K
    pd.Series(adata.var_names).to_csv(os.path.join(out_dir, "genes.tsv"), sep="\t", index=False, header=False)
    meta.to_csv(os.path.join(out_dir, "samples.tsv"), sep="\t", index=False)
    print(f"  n donors: {len(donor_ids)}; saved raw + norm -> {out_dir}")
    print(meta[['donor_id','age','sex','n_samples','n_cells']].head())
    return meta

# Generate for each celltype
all_meta = {}
for ct in celltypes:
    all_meta[ct] = make_sample_pseudobulk(ct)

print("\n=== All done (based on clean5 raw counts) ===")



#############
############# Next, compute DEGs in R ####
############# Compute separately by sex, with weights to address sample imbalance ######
#############

R

library(Matrix)
library(mgcv)
library(parallel)

pb_root   = "/projects/hmz-aging/Human_New_Datasets/pseudobulk_sample"
celltypes = c("AC","BC","RGC","Rod","Cone","HC","MG","Microglia","RPE")

###### Read per-donor pseudobulk for one celltype ######
## which = "norm" (log2-CP10K, for GAM) or "raw" (raw counts, for edgeR)
read_human_pb <- function(ct, root = pb_root, which = c("norm","raw")){
    which = match.arg(which)
    d     = file.path(root, ct)
    mat   = as.matrix(readMM(file.path(d, paste0("matrix_", which, ".mtx"))))  # gene x donor
    genes = read.table(file.path(d, "genes.tsv"),   sep="\t", header=FALSE, stringsAsFactors=FALSE)[,1]
    meta  = read.table(file.path(d, "samples.tsv"), sep="\t", header=TRUE,  stringsAsFactors=FALSE)
    rownames(mat) = genes
    colnames(mat) = as.character(meta$donor_id)
    list(bulk_mat = mat, bulk_meta = meta)
}

###### Age bins (unequal widths, midpoints = 10,25,37.5,50,60,70,80,90; wider at the young end to balance sparse samples) ######
age_breaks = c(0,20,30,45,55,65,75,85,95)
age_labels = c("10","25","37.5","50","60","70","80","90")

###### Weights: total weight per bin proportional to interval width; divided by sample count within bin (removes sample-size imbalance) ######
## -> wide intervals (e.g. 0-20) get more total weight; abundant old samples do not dominate
make_age_weights <- function(age, breaks = age_breaks){
    bin           = cut(as.numeric(age), breaks = breaks, right = FALSE, include.lowest = TRUE)
    widths        = diff(breaks)                   # width of each interval
    names(widths) = levels(bin)
    n_per_bin     = table(bin)
    w = widths[as.character(bin)] / as.numeric(n_per_bin[as.character(bin)])
    w[is.na(w)] = mean(w, na.rm = TRUE)            # ages outside bins get the mean, avoids NA
    as.numeric(w / mean(w))                        # normalize, mean = 1
}

###### Weighted GAM smoothing (original Smooth_FUN plus weights, made more robust) ######
Smooth_FUN <- function(x, age, w = NULL){
    vector = as.numeric(scale(as.numeric(x)))
    if(is.null(w)) w = rep(1, length(vector))
    # Constant row / all NA -> return p=1 directly
    if(length(unique(vector[!is.na(vector)])) <= 1){
        return(data.frame(age = age, value = vector, predict = vector, p_value = 1))
    }
    df = data.frame(age = age, value = vector, w = w)
    df = df[order(df$age), ]
    rownames(df) = 1:nrow(df)
    # Adaptive k: cannot exceed the number of unique ages
    k_use = min(4, length(unique(df$age)))
    fit = tryCatch(
        gam(value ~ s(age, k = k_use), data = df, weights = df$w, select = TRUE),
        error = function(e) NULL)
    if(is.null(fit)){                          # gam failed -> fall back to p=1
        df$predict = df$value; df$p_value = 1; return(df)
    }
    st = summary(fit)$s.table
    df$p_value = if(nrow(st) >= 1) st[1, 4] else 1
    df$predict = predict(fit, newdata = df, type = "response")
    df
}

###### Identify DEGs on the bulk of one (celltype, sex) subset (weighted GAM) ######
## bulk_list: list(bulk_mat = gene x donor, bulk_meta = data.frame(with age))
Identify_DEGs <- function(bulk_list, avg_cutoff = 0.01, ncores = 20){
    bulk_mat  = bulk_list$bulk_mat
    bulk_meta = bulk_list$bulk_meta
    stopifnot(identical(colnames(bulk_mat), as.character(bulk_meta$donor_id)))
    # Remove donors with unparseable age (NA age breaks weights/gam)
    age = suppressWarnings(as.numeric(bulk_meta$age))
    ok  = which(!is.na(age))
    if(length(ok) < length(age)) message("    Removed ", length(age)-length(ok), " NA-age donors")
    bulk_mat = bulk_mat[, ok, drop = FALSE]
    age      = age[ok]
    # Filter lowly expressed genes
    avg_by_gene = rowMeans(bulk_mat)
    bulk_mat    = bulk_mat[avg_by_gene > avg_cutoff, , drop = FALSE]
    # Inverse-frequency weights (by age bin)
    w = make_age_weights(age)
    # Per-gene weighted GAM
    res_list = mclapply(seq_len(nrow(bulk_mat)),
                        function(i) Smooth_FUN(bulk_mat[i, ], age = age, w = w),
                        mc.cores = ncores)
    # Fault-tolerant extraction: genes with non-data.frame (try-error) results get p=1, delta=0
    pvalue = vapply(res_list, function(z) if(is.data.frame(z)) z$p_value[1] else 1, numeric(1))
    delta  = vapply(res_list, function(z) if(is.data.frame(z)) z$predict[nrow(z)] - z$predict[1] else 0, numeric(1))
    res = data.frame(Gene   = rownames(bulk_mat),
                     pvalue = pvalue,
                     FDR    = p.adjust(pvalue, method = "BH"),
                     delta_old_vs_young = delta,
                     stringsAsFactors = FALSE)
    res = res[order(res$pvalue), ]
    res
}

###### Main loop: compute separately for each celltype x each sex ######
Human_DEGs = list()
for(ct in celltypes){
    message("\n==== ", ct, " ====")
    pb = read_human_pb(ct, which = "norm")
    Human_DEGs[[ct]] = list()
    for(sx in c("male","female")){
        keep = which(tolower(pb$bulk_meta$sex) == sx)
        sub_meta = pb$bulk_meta[keep, , drop = FALSE]
        sub_mat  = pb$bulk_mat[, keep, drop = FALSE]
        n_donor  = length(keep)
        n_bin    = length(unique(cut(as.numeric(sub_meta$age),
                                     breaks = age_breaks,
                                     right = FALSE, include.lowest = TRUE)))
        message("  ", sx, ": ", n_donor, " donors, ", n_bin, " age-bins")
        if(n_donor < 5 || n_bin < 3){
            message("    -> too few samples/age bins, skipping")
            next
        }
        Human_DEGs[[ct]][[sx]] = Identify_DEGs(list(bulk_mat = sub_mat, bulk_meta = sub_meta))
        message("    -> DEGs (pvalue<0.05): ",
                sum(Human_DEGs[[ct]][[sx]]$pvalue < 0.05, na.rm = TRUE))
    }
}

saveRDS(Human_DEGs, file.path(pb_root, "Human_DEGs_GAM_bySex.rds"))
message("\nSaved: ", file.path(pb_root, "Human_DEGs_GAM_bySex.rds"))



#####
##### Per age bin: average donor CP10K -> log2(mean+1) -> combine male/female -> kmeans -> heatmap
##### (adapted from the zebrafish code)
#####

bin_of_age <- function(age){
    as.character(cut(as.numeric(age), breaks = age_breaks, labels = age_labels,
                     right = FALSE, include.lowest = TRUE))
}

###### One (celltype, sex) subset: average donor CP10K within bin, then log2(mean+1) -> gene x bin ######
## mat: log2(CP10K+1); first back-transform CP10K = 2^mat - 1
make_bin_avg <- function(mat, meta){
    bin = bin_of_age(meta$age)
    ub  = age_labels[age_labels %in% unique(bin)]          # keep only bins with data, in age order
    cp10k = (2^mat) - 1
    out = sapply(ub, function(b) {
        log2(rowMeans(cp10k[, bin == b, drop = FALSE]) + 1)
    })
    out = as.matrix(out)
    rownames(out) = rownames(mat); colnames(out) = ub
    out
}

###### Bin aggregation for each celltype x sex (average after back-transforming norm = log2(CP10K+1)) ######
Human_bin_list = list()
for(ct in celltypes){
    pb = read_human_pb(ct, which = "norm")
    Human_bin_list[[ct]] = list()
    for(sx in c("male","female")){
        keep = which(tolower(pb$bulk_meta$sex) == sx)
        Human_bin_list[[ct]][[sx]] = make_bin_avg(pb$bulk_mat[, keep, drop = FALSE],
                                                  pb$bulk_meta[keep, , drop = FALSE])
    }
}

###### Bins shared by all (celltype, sex) (columns; ensures no NA after stacking) ######
bins_each  = list()
for(ct in celltypes) for(sx in c("male","female"))
    bins_each[[paste(ct,sx)]] = colnames(Human_bin_list[[ct]][[sx]])
common_bin = age_labels[age_labels %in% Reduce(intersect, bins_each)]
message("Shared age bins (columns): ", paste(common_bin, collapse = ", "))

###### DEG genes per celltype (union of pvalue<0.05 in either male or female) ######
get_deg_genes <- function(ct){
    g = c()
    for(sx in c("male","female")){
        d = Human_DEGs[[ct]][[sx]]
        if(!is.null(d)) g = c(g, d$Gene[which(d$pvalue < 0.05)])
    }
    unique(g)
}

###### Stack male/female by row (M_/F_ row-name prefix), columns = shared age bins, DEG genes only ######
row_list = list()
for(ct in celltypes){
    degg = get_deg_genes(ct)
    for(sx in c("male","female")){
        pref = ifelse(sx == "male", "M_", "F_")
        m = Human_bin_list[[ct]][[sx]][, common_bin, drop = FALSE]
        m = m[rownames(m) %in% degg, , drop = FALSE]
        rownames(m) = paste0(pref, ct, "__", rownames(m))   # row name: M_/F_ + celltype__gene
        row_list[[paste(ct,sx)]] = m
    }
}
Human_DEGs_Plot_raw = do.call(rbind, row_list)
message("Combined matrix: ", nrow(Human_DEGs_Plot_raw), " rows x ", ncol(Human_DEGs_Plot_raw), " bins")

###### Row-wise scale (z-score); constant rows (sd=0) set to 0 ######
Human_DEGs_Plot = t(apply(Human_DEGs_Plot_raw, 1, scale))
rownames(Human_DEGs_Plot) = rownames(Human_DEGs_Plot_raw)
colnames(Human_DEGs_Plot) = colnames(Human_DEGs_Plot_raw)
Human_DEGs_Plot[is.na(Human_DEGs_Plot)] = 0

saveRDS(Human_DEGs_Plot, file.path(pb_root, "Human_DEGs_Plot.rds"))

###### kmeans (reuses the zebrafish Kmeans_function) ######
Kmeans_function <- function(Plot, k = 18){
    Plot[Plot > 4]  =  4
    Plot[Plot < -4] = -4
    set.seed(123)
    kc = kmeans(Plot, k, iter.max = 100, nstart = 20)
    data.frame(genes = names(kc$cluster), cluster = as.numeric(kc$cluster))
}
Human_DEGs_Plot_Kmeans = Kmeans_function(Human_DEGs_Plot, k = 24)

###### Draw heatmap (columns = age bins; rows = sex+celltype genes, split by kmeans cluster) ######
library('ComplexHeatmap')
library('circlize')

# Row annotation: celltype and sex (both parsed from row names)
celltype = sub("^[MF]_", "", rownames(Human_DEGs_Plot))
celltype = sapply(strsplit(celltype, split = "__"), function(x) x[[1]])
sex      = ifelse(grepl("^M_", rownames(Human_DEGs_Plot)), "Male", "Female")
celltype_colors <- c("MG"="#D11536","RGC"="#AAA9A9","AC"="#F6BA00","HC"="#EF9000",
                     "BC"="#804537","Rod"="#026AB1","Cone"="#9EA220","RPE"="#936DAD",
                     "Microglia"="#EC6F64")
sex_colors <- c("Male" = "#3C5488", "Female" = "#E64B35")
ra <- rowAnnotation(CellType = celltype, Sex = sex,
                    col = list(CellType = celltype_colors, Sex = sex_colors),
                    annotation_name_side = "top")

row_sp  = as.factor(Human_DEGs_Plot_Kmeans$cluster)
col_fun = colorRamp2(c(-2,-1,0,1,2), c('#026AB1','lightblue','white','#EF9000','#D11536'))

setwd("/projects/hmz-aging/Human_New_Datasets")
png('Human_DEGs.png', height = 7000, width = 4000, res = 72*12)
Heatmap(Human_DEGs_Plot, name = "z", right_annotation = ra, border = TRUE,
        use_raster = TRUE, raster_quality = 5,          # enable raster for many rows to avoid washed-out colors
        show_row_names = FALSE, show_column_names = TRUE,
        rect_gp = gpar(col = 'white', lwd = 0),
        cluster_rows = FALSE, cluster_columns = FALSE, col = col_fun,
        row_split = row_sp,
        heatmap_legend_param = list(title = "z", border = 'black', at = c(-2,-1,0,1,2)))
dev.off()

saveRDS(Human_DEGs_Plot_Kmeans, file.path(pb_root, "Human_DEGs_Plot_Kmeans.rds"))


