library(fgsea)
library(ggplot2)
library(scales)
library(org.Hs.eg.db)

pb_root  = "/projects/hmz-aging/Human_New_Datasets/pseudobulk_sample"
out_dir  = "/projects/hmz-aging/Human_New_Datasets"
