#####
##### edgeR: Old vs Young computed separately by sex (raw counts); save / build Rank per sex #####
#####

library(edgeR)

###### edgeR: Old vs Young within a single sex (~ group); middle ages discarded ######
call_DEG_edgeR <- function(list_process, young_max = 40, old_min = 80, min_n = 2,
                           sex_keep = c("male","female")){
    sex_keep  = match.arg(sex_keep)
    bulk_mat  = as.matrix(list_process$bulk_mat)
    bulk_meta = list_process$bulk_meta
    stopifnot(identical(colnames(bulk_mat), as.character(bulk_meta$donor_id)))
    age = suppressWarnings(as.numeric(bulk_meta$age))
    sex = tolower(as.character(bulk_meta$sex))
    grp = rep(NA_character_, length(age))
    grp[age <= young_max] = "Young"
    grp[age >= old_min]   = "Old"
    keep_s = which(!is.na(grp) & sex == sex_keep)
    counts = round(bulk_mat[, keep_s, drop = FALSE])
    group  = factor(grp[keep_s], levels = c("Young","Old"))
    if(length(keep_s) == 0 || nlevels(droplevels(group)) < 2 || min(table(group)) < min_n){
        message("  ", sex_keep, " insufficient samples, skipping: ",
                paste(names(table(group)), as.integer(table(group)), collapse = " "))
        return(NULL)
    }
    y = DGEList(counts = counts, group = group)
    keep_g = filterByExpr(y, group = group)
    y = y[keep_g, , keep.lib.sizes = FALSE]
    y = calcNormFactors(y)
    design = model.matrix(~ group)                 # no sex covariate within a single sex
    y   = estimateDisp(y, design)
    fit = glmQLFit(y, design)
    qlf = glmQLFTest(fit, coef = 2)
    res = topTags(qlf, n = Inf, sort.by = "PValue")$table
    res = data.frame(Gene = rownames(res), res, row.names = NULL)
    res$direction = ifelse(res$logFC > 0, "Up_Old", "Down_Old")
    res$sex = sex_keep
    res
}

####### Compute / save separately for each celltype x sex #######
Human_DEG_edgeR = list()
for(ct in celltypes){
    message("\n==== ", ct, " ====")
    pb_raw = read_human_pb(ct, which = "raw")
    Human_DEG_edgeR[[ct]] = list()
    for(sx in c("male","female")){
        res = call_DEG_edgeR(pb_raw, young_max = 40, old_min = 80, sex_keep = sx)
        if(is.null(res)) next
        n_up   = sum(res$PValue < 0.05 & res$logFC > 0)
        n_down = sum(res$PValue < 0.05 & res$logFC < 0)
        message(sprintf("  %s: Up(higher in Old)=%d, Down(lower in Old)=%d (PValue<0.05)", sx, n_up, n_down))
        Human_DEG_edgeR[[ct]][[sx]] = res
    }
}
saveRDS(Human_DEG_edgeR, file.path(pb_root, "Human_DEG_edgeR_bySex.rds"))
message("Saved: ", file.path(pb_root, "Human_DEG_edgeR_bySex.rds"))


######
###### Build rank per sex (for GSEA; no Kmeans4, score all edgeR genes directly)
###### ranking metric = sign(logFC) * -log10(PValue)
######

######
