library(ggplot2)

###### Number of DEGs per celltype in each direction (Down=Young / Up=Old / Middle) ######
make_bar_data <- function(kc, Downclusters, Middleclusters, Upclusters){
    kc$cell_type = sapply(strsplit(sub("^[MF]_", "", kc$genes), split = "__"),
                          function(x) x[[1]])
    index = names(table(kc$cell_type))
    cell_type = c(); num_DEGs = c(); direction = c()
    for(i in seq_along(index)){
        cell_type = c(cell_type, rep(index[i], 3))
        k1 = sum(kc$cell_type == index[i] & kc$cluster %in% Downclusters)
        k2 = sum(kc$cell_type == index[i] & kc$cluster %in% Upclusters)
        k3 = sum(kc$cell_type == index[i] & kc$cluster %in% Middleclusters)
        num_DEGs  = c(num_DEGs, k1, k2, k3)
        direction = c(direction, c("Young", "Old", "Middle"))
    }
    data = data.frame(cell_type = cell_type, num_DEGs = num_DEGs, direction = direction)
    data$direction = factor(data$direction, levels = c("Young","Middle","Old"))
    res = tapply(data$num_DEGs, data$cell_type, function(x) sum(abs(x)))
    data$cell_type = factor(data$cell_type, levels = rev(names(res)[order(res)]))
    data
}

###### Groups after renumbering: correspond directly to new_order_down / middle / up above ######
n_down = length(new_order_down)
