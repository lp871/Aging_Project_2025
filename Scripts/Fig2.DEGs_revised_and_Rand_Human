pb_root = "/projects/hmz-aging/Human_New_Datasets/pseudobulk_sample"
Human_DEG_edgeR = readRDS(file.path(pb_root, "Human_DEG_edgeR_bySex.rds"))
message("Loaded Human_DEG_edgeR: ",
        paste(names(Human_DEG_edgeR), collapse = ", "))
message("=== Loading done, continue with rank below ===")

Build_Rank_from_DEG <- function(deg, eps = 1e-300){
    pv = deg$PValue; pv[is.na(pv)] = 1
    pv[pv < eps] = eps
    stat = sign(deg$logFC) * (-log10(pv))
    names(stat) = deg$Gene
    stat = stat[!is.na(stat)]
    stat = tapply(stat, names(stat), function(x) x[which.max(abs(x))])
    sort(stat, decreasing = TRUE)
}

flatten_rank <- function(rank_nested){
    flat = list()
    for(ct in names(rank_nested))
        for(sx in names(rank_nested[[ct]]))
            flat[[paste(ct, sx, sep = "_")]] = rank_nested[[ct]][[sx]]
    flat
}

Human_DEG_rank = list()
for(ct in names(Human_DEG_edgeR)){
    Human_DEG_rank[[ct]] = list()
    for(sx in names(Human_DEG_edgeR[[ct]])){
        deg = Human_DEG_edgeR[[ct]][[sx]]
        Human_DEG_rank[[ct]][[sx]] = Build_Rank_from_DEG(deg)
        message(sprintf("[rank] %s %s: n=%d, nonzero=%d",
                        ct, sx, length(Human_DEG_rank[[ct]][[sx]]),
                        sum(Human_DEG_rank[[ct]][[sx]] != 0)))
    }
}
Human_DEG_rank = flatten_rank(Human_DEG_rank)   # flattened: AC_male / AC_female ...
saveRDS(Human_DEG_rank, file.path(pb_root, "Human_DEG_rank.rds"))
message("Saved: ", file.path(pb_root, "Human_DEG_rank.rds"))


