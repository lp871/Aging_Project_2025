Mouse_pseudo_count_input_raw = list()
for(i in 1:length(Mouse_pseudo_count_raw)){
    tmp_mat = as.matrix(Mouse_pseudo_count_raw[[i]])
    tmp_age = as.numeric(sub("_Rep.*$", "", sub("^Wk", "", colnames(tmp_mat))))
    tmp_table = data.frame(sample = colnames(tmp_mat), age = tmp_age)
    Mouse_pseudo_count_input_raw[[i]] = list(bulk_mat = tmp_mat, bulk_meta = tmp_table)
}
names(Mouse_pseudo_count_input_raw) = names(Mouse_pseudo_count_raw)

## Old vs Young: age <= young_max -> Young; age >= old_min -> Old; logFC>0 means higher in Old
call_DEG_edgeR <- function(list_process, young_max = 12, old_min = 100, min_n = 2){
    bulk_mat  = as.matrix(list_process$bulk_mat)
    bulk_meta = list_process$bulk_meta
    stopifnot(identical(colnames(bulk_mat), as.character(bulk_meta$sample)))
    age = as.numeric(bulk_meta$age)
    grp = rep(NA_character_, length(age))
    grp[age <= young_max] = "Young"
    grp[age >= old_min]   = "Old"
    keep_s = which(!is.na(grp))
    counts = round(bulk_mat[, keep_s, drop = FALSE])
    group  = factor(grp[keep_s], levels = c("Young","Old"))
    if(nlevels(droplevels(group)) < 2 || min(table(group)) < min_n){
        message("Insufficient samples, skipping: ", paste(names(table(group)), table(group), collapse=" ")); return(NULL)
    }
    y = DGEList(counts = counts, group = group)
    keep_g = filterByExpr(y, group = group)
    y = y[keep_g, , keep.lib.sizes = FALSE]
    y = calcNormFactors(y)
    design = model.matrix(~ group)
    y = estimateDisp(y, design)
    fit = glmQLFit(y, design)
    qlf = glmQLFTest(fit, coef = 2)
    res = topTags(qlf, n = Inf, sort.by = "PValue")$table
    res = data.frame(Gene = rownames(res), res, row.names = NULL)
    res$direction = ifelse(res$logFC > 0, "Up_Old", "Down_Old")
    return(res)
}

Mouse_DEG_edgeR = list()
for(ct in names(Mouse_pseudo_count_input_raw)){
    message("==== ", ct, " ====")
    res = call_DEG_edgeR(Mouse_pseudo_count_input_raw[[ct]], young_max = 12, old_min = 100)
    if(is.null(res)) next
    message(sprintf("%s: Up(higher in Old) = %d, Down(lower in Old) = %d (PValue<0.05)",
                    ct, sum(res$PValue<0.05 & res$logFC>0), sum(res$PValue<0.05 & res$logFC<0)))
    Mouse_DEG_edgeR[[ct]] = res
}

######
###### 2. rank (consistent with Human noKmeans): edgeR only, no intersection with Kmeans ######
######    metric = sign(logFC) * -log10(PValue); score all edgeR genes directly
######
Build_Rank_from_DEG <- function(deg, eps = 1e-300){
    pv = deg$PValue; pv[is.na(pv)] = 1
    pv[pv < eps] = eps
    stat = sign(deg$logFC) * (-log10(pv))
    names(stat) = deg$Gene
    stat = stat[!is.na(stat)]
    stat = tapply(stat, names(stat), function(x) x[which.max(abs(x))])
    sort(stat, decreasing = TRUE)
}

Mouse_DEG_rank = list()
for(ct in names(Mouse_DEG_edgeR)){
    deg = Mouse_DEG_edgeR[[ct]]
    Mouse_DEG_rank[[ct]] = Build_Rank_from_DEG(deg)
    message(sprintf("[noKmeans] %s: n=%d, nonzero=%d (P<0.05 up=%d down=%d)",
                    ct, length(Mouse_DEG_rank[[ct]]),
                    sum(Mouse_DEG_rank[[ct]] != 0),
                    sum(deg$PValue < 0.05 & deg$logFC > 0, na.rm = TRUE),
                    sum(deg$PValue < 0.05 & deg$logFC < 0, na.rm = TRUE)))
}
saveRDS(Mouse_DEG_rank, file = "Mouse_DEG_rank_noKmeans.rds")
message("Saved: Mouse_DEG_rank_noKmeans.rds")


######
###### Replace RPE ranks: use avg_log2FC + p_val from scRNAseq 91W_RPE vs 5W_RPE ######
###### (same formula as noKmeans ranks of other celltypes: sign(logFC)*-log10(P)) ######
######
library(Seurat)
library(dplyr)

## 1. Load RPE scRNAseq, select RPE cells, normalize
Mouse_RPE = readRDS("/projects/hmz-aging/RPE_smoking/Mouse_RPE_RNA_Final_Jul16")
Mouse_RPE_cl = Mouse_RPE[, Mouse_RPE$celltype %in% c("RPE", "Retinal pigment epithelial cells")]
Mouse_RPE_cl$sample = factor(Mouse_RPE_cl$sample, levels = c("5W_RPE", "49W_RPE", "91W_RPE"))
DefaultAssay(Mouse_RPE_cl) = "RNA"
Mouse_RPE_cl = NormalizeData(Mouse_RPE_cl)
Idents(Mouse_RPE_cl) = "sample"

## 2. Old(91W) vs Young(5W): avg_log2FC + p_val for all genes
##    relax logfc.threshold/min.pct to keep as many genes as possible in the rank
markers_old_young = FindMarkers(Mouse_RPE_cl, ident.1 = "91W_RPE", ident.2 = "5W_RPE",
                                logfc.threshold = 0, min.pct = 0.05)
markers_old_young$gene_symbol = sub(".*~~", "", rownames(markers_old_young))

## 3. rank = sign(avg_log2FC) * -log10(p_val); no consistent-list filtering
build_rpe_rank <- function(mk, eps = 1e-300){
    pv = mk$p_val; pv[is.na(pv)] = 1; pv[pv < eps] = eps
    fc = mk$avg_log2FC
    if(is.null(fc)) fc = mk$avg_logFC          # compatible with older Seurat column name
    sym = mk$gene_symbol
    stat = sign(fc) * (-log10(pv))
    names(stat) = sym
    stat = stat[!is.na(stat)]
    stat = tapply(stat, names(stat), function(x) x[which.max(abs(x))])
    sort(stat, decreasing = TRUE)
}
RPE_rank = build_rpe_rank(markers_old_young)
message(sprintf("RPE rank (91W vs 5W): n=%d, nonzero=%d (pos=%d / neg=%d); P<0.05 up=%d down=%d",
                length(RPE_rank), sum(RPE_rank != 0),
                sum(RPE_rank > 0), sum(RPE_rank < 0),
                sum(markers_old_young$p_val < 0.05 & markers_old_young$avg_log2FC > 0, na.rm = TRUE),
                sum(markers_old_young$p_val < 0.05 & markers_old_young$avg_log2FC < 0, na.rm = TRUE)))

## 4. Replace with the scRNAseq RPE rank
Mouse_DEG_rank[["RPE"]] = RPE_rank
saveRDS(Mouse_DEG_rank, file = "Mouse_DEG_rank_noKmeans.rds")
message("Updated and saved: Mouse_DEG_rank_noKmeans.rds (with RPE scRNA rank)")







######
###### 3. Map mouse gene ranks to human orthologs (keep all one-to-many, equal weights) ######
######
load("/projects/hmz-aging/Zebrafish_New_Datasets/HMZ_ortholog_combined")
HM = unique(HMZ_ortholog_combined$HM[, c("human", "mouse")])
HM = HM[HM$human != "" & HM$mouse != "", ]

mouse_rank_to_human <- function(rank_vec, HM){
    df = data.frame(mouse = names(rank_vec), stat = as.numeric(rank_vec), stringsAsFactors = FALSE)
    mg = merge(df, HM, by = "mouse")
    if(nrow(mg) == 0) return(numeric(0))
    stat = tapply(mg$stat, mg$human, function(x) x[which.max(abs(x))])
    sort(stat, decreasing = TRUE)
}

Mouse_DEG_rank_human = lapply(Mouse_DEG_rank, mouse_rank_to_human, HM = HM)
names(Mouse_DEG_rank_human) = names(Mouse_DEG_rank)
print(data.frame(
    celltype = names(Mouse_DEG_rank),
    mouse    = sapply(Mouse_DEG_rank, length),
    human    = sapply(Mouse_DEG_rank_human, length),
    human_nonzero = sapply(Mouse_DEG_rank_human, function(x) sum(x != 0))
))

setwd("/projects/hmz-aging/Mouse_New_Datasets")
save(Mouse_DEG_rank_human, file = "Mouse_DEG_rank_human")


