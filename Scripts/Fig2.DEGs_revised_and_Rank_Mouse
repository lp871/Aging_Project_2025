#######
####### Generate DEGs plot (prepare heatmap) #######
####### Average samples at the same time point; merge age 106 into 108 #######
#######

## Column names Wk<age>_Rep<n> -> aggregate by age (106 recoded to 108)
collapse_samples_by_age_mouse <- function(mat){
    ages = as.numeric(sub("_Rep.*$", "", sub("^Wk", "", colnames(mat))))
    ages[ages == 106] = 108                       # merge 106 into the 108 time point
    uages = sort(unique(ages))
    out = sapply(uages, function(a) rowMeans(mat[, ages == a, drop = FALSE]))
    out = as.matrix(out)
    rownames(out) = rownames(mat)
    colnames(out) = as.character(uages)
    out
}

Merge_DEGs_genes_and_Avg_expression <- function(DEGs_List, Avgs_List, col_index){
    #### Each celltype: average by time point, prefix row names with celltype
    Avgs_List2 = list()
    for(i in 1:length(Avgs_List)){
        tmp = Avgs_List[[i]][[1]]
        tmp = collapse_samples_by_age_mouse(tmp)
        rownames(tmp) = paste(names(Avgs_List)[i], rownames(tmp), sep = "__")
        print(dim(tmp))
        Avgs_List2[[i]] = tmp
    }
    all_Matrix = do.call("rbind", Avgs_List2)
    #### Also prefix DEGs with celltype
    for(i in 1:length(DEGs_List)){
        tmp = DEGs_List[[i]]
        tmp$Gene = paste(names(DEGs_List)[i], tmp$Gene, sep = "__")
        DEGs_List[[i]] = tmp
    }
    all_DEGs = do.call("rbind", DEGs_List)
    #### Keep only DEG rows, select time points by col_index, scale rows
    all_Matrix_cl = all_Matrix[which(rownames(all_Matrix) %in% all_DEGs$Gene == TRUE), ]
    all_Matrix_cl = all_Matrix_cl[, col_index]
    all_Matrix_cl_s = t(apply(all_Matrix_cl, 1, scale))
    rownames(all_Matrix_cl_s) = rownames(all_Matrix_cl)
    colnames(all_Matrix_cl_s) = colnames(all_Matrix_cl)
    return(all_Matrix_cl_s)
}

