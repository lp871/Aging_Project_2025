category_sets = human_aging_catalog$category_unions
sapply(category_sets, length)

######
###### 2. fgsea runner (single celltype) ######
######
run_fgsea_one <- function(ranks, pathways, minSize = 5, maxSize = 5000){
    ranks = ranks[is.finite(ranks)]
    ranks = sort(ranks, decreasing = TRUE)
    set.seed(123)
    res = fgsea(pathways = pathways, stats = ranks,
                minSize = minSize, maxSize = maxSize, eps = 0)
    res = res[order(res$NES, decreasing = TRUE), ]
    return(res)
}

######
###### 3. Compute category enrichment for each celltype ######
######
Mouse_GSEA_category = list()
for(ct in names(Mouse_DEG_rank_human)){
    ranks = Mouse_DEG_rank_human[[ct]]
    if(length(ranks) < 10){ message("Skipped (too few genes): ", ct); next }
    message("==== fgsea: ", ct, " ====")
    res = run_fgsea_one(ranks, category_sets)
    res$celltype = ct
    Mouse_GSEA_category[[ct]] = res
}

Mouse_GSEA_category_df = do.call(rbind, lapply(Mouse_GSEA_category, function(x){
    data.frame(celltype = x$celltype, category = x$pathway,
               NES = x$NES, ES = x$ES, pval = x$pval, padj = x$padj, size = x$size,
               stringsAsFactors = FALSE)
}))
rownames(Mouse_GSEA_category_df) = NULL
Mouse_GSEA_category_df = Mouse_GSEA_category_df[
    order(Mouse_GSEA_category_df$celltype, -Mouse_GSEA_category_df$NES), ]
