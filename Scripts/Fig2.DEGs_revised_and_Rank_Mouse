#######
####### Trend scatter plot: one facet per cluster, red line = mean trend #######
#######
Plot_dot <- function(Plot, Kmeans_order){
    library(reshape2)
    df = melt(Plot)                       # Var1=gene, Var2=age(column), value
    df$class = Kmeans_order$cluster[match(df$Var1, Kmeans_order$genes)]
    #### Order x axis by numeric time point (avoid string sorting placing 120 before 17)
    age_levels = as.character(sort(as.numeric(unique(as.character(df$Var2)))))
    df$Var2 = factor(df$Var2, levels = age_levels)
    df$Var2_1 = as.numeric(df$Var2)
    cl_levels = sort(unique(Kmeans_order$cluster))
    df$class = factor(df$class, levels = cl_levels)
    return(df)
}

