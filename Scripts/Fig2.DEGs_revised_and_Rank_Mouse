#########
######### pseudobulk function: aggregate each celltype by sample #######
#########
getPseudoBulkByCellSample <- function(
  seurat_obj,
  assay_name   = "RNA",
  layer_name   = "counts",
  celltype_col = "celltype",
  sample_col   = "sample",
  normalize    = TRUE
) {
  library(Matrix)
  # 1. Extract data (Seurat 5: layer replaces slot)
  counts <- Seurat::GetAssayData(seurat_obj, assay = assay_name, layer = layer_name)
  meta   <- seurat_obj@meta.data
  # 2. Validation
  if (!all(c(celltype_col, sample_col) %in% colnames(meta))) {
    stop("Columns not found in meta.data: ",
         paste(setdiff(c(celltype_col, sample_col), colnames(meta)), collapse = ", "))
  }
  if (!inherits(counts, "dgCMatrix")) {
    counts <- as(counts, "dgCMatrix")
  }
  # 3. Get all celltypes
  ct_levels <- c("MG","RGC","AC","HC","Cone","Rod","BC","Microglia","RPE")
  # 4. For each celltype, aggregate by sample
  pb_list <- lapply(ct_levels, function(ct) {
    cells_ct <- rownames(meta)[meta[[celltype_col]] == ct]
    if (length(cells_ct) == 0) return(NULL)
    sub_counts <- counts[, cells_ct, drop = FALSE]
    sub_meta   <- meta[cells_ct, , drop = FALSE]
    grp_sample <- factor(sub_meta[[sample_col]],
                         levels = sort(unique(sub_meta[[sample_col]])))
    design <- model.matrix(~0 + grp_sample)
    colnames(design) <- levels(grp_sample)
    Matrix(sub_counts %*% Matrix(design, sparse = TRUE), sparse = TRUE)
  })
  names(pb_list) <- ct_levels
  #### normalize=TRUE: return log2-CPM (for GAM/heatmap); FALSE: return raw counts (for edgeR)
  if (isTRUE(normalize)) {
    return(normalizePBList(pb_list))
  } else {
    return(pb_list)
  }
}

#########
######### library-size normalization -> log2-CPM #######
#########
normalizePBList <- function(pb_list, scale = 1e4, pseudocount = 1) {
  lapply(pb_list, function(mat) {
    lib_sizes <- Matrix::colSums(mat)
    cpm <- t( t(mat) / lib_sizes * scale )
    log2(cpm + pseudocount)
  }) -> normalized_list
  names(normalized_list) <- names(pb_list)
  normalized_list
}

