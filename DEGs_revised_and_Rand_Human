convert_rank_to_symbol <- function(rank_vec){
    if(length(rank_vec) == 0) return(rank_vec)
    nm     = names(rank_vec)
    is_ens = grepl("^ENSG", nm)
    if(!any(is_ens)) return(rank_vec)
    sym = nm
    ens = sub("\\..*$", "", nm[is_ens])
    sym[is_ens] = mapIds(org.Hs.eg.db, keys = ens, keytype = "ENSEMBL",
                         column = "SYMBOL", multiVals = "first")
    df = data.frame(sym = sym, val = as.numeric(rank_vec), stringsAsFactors = FALSE)
    df = df[!is.na(df$sym), ]
    out = tapply(df$val, df$sym, function(x) x[which.max(abs(x))])
    sort(out, decreasing = TRUE)
}

run_fgsea_one <- function(ranks, pathways, minSize = 5, maxSize = 5000){
    ranks = ranks[is.finite(ranks)]
    ranks = sort(ranks, decreasing = TRUE)
    set.seed(123)
    res = fgsea(pathways = pathways, stats = ranks,
                minSize = minSize, maxSize = maxSize, eps = 0)
    res[order(res$NES, decreasing = TRUE), ]
}

## 对一套扁平 rank (名字=celltype_sex) 跑大类 GSEA，返回 list + df
run_category_gsea <- function(rank_flat, pathways, tag){
    message("\n########## GSEA category: ", tag, " ##########")
    gsea_list = list()
    for(nm in names(rank_flat)){
        ranks = rank_flat[[nm]]
        if(length(ranks) < 10){ message("跳过(基因太少): ", nm); next }
        message("==== ", nm, " ====")
        res = run_fgsea_one(ranks, pathways)
        res$celltype = nm
        gsea_list[[nm]] = res
    }
    df = do.call(rbind, lapply(gsea_list, function(x){
        data.frame(celltype = x$celltype, category = x$pathway,
                   NES = x$NES, ES = x$ES, pval = x$pval, padj = x$padj, size = x$size,
                   stringsAsFactors = FALSE)
    }))
    rownames(df) = NULL
    df$sex  = sub(".*_(male|female)$", "\\1", df$celltype)
    df$ct   = sub("_(male|female)$", "", df$celltype)
    df$mode = tag
    df = df[order(df$ct, df$sex, -df$NES), ]
    list(list = gsea_list, df = df)
}

## 画单张气泡图: 固定一个 mode + 一个 sex
plot_category_bubble <- function(df, mode, sex, outfile,
                                 ct_levels = c("MG","RGC","AC","HC","BC","Cone","Rod","Microglia","RPE")){
    plot_df = df[df$mode == mode & df$sex == sex, , drop = FALSE]
    if(nrow(plot_df) == 0){
        message("无数据, 跳过作图: ", mode, " / ", sex)
        return(invisible(NULL))
    }
    plot_df$neglogP = -log10(pmax(plot_df$pval, 1e-300))
    cat_all    = unique(plot_df$category)
    cat_num    = as.numeric(sub("^C([0-9]+)_.*", "\\1", cat_all))
    cat_levels = cat_all[order(cat_num)]
    ct_use     = ct_levels[ct_levels %in% plot_df$ct]
    plot_df$category = factor(plot_df$category, levels = rev(cat_levels))
    plot_df$ct       = factor(plot_df$ct, levels = ct_use)
    plot_sig = plot_df[plot_df$pval < 0.05 & !is.na(plot_df$pval), ]
    p = ggplot(plot_sig, aes(x = ct, y = category)) +
      geom_point(aes(size = neglogP, fill = NES), shape = 21, color = "grey30", stroke = 0.3) +
      scale_fill_gradient2(low = "#3C5488", mid = "white", high = "#E64B35",
                           midpoint = 0, name = "NES", limits = c(-3, 3), oob = scales::squish) +
      scale_size_continuous(range = c(2, 9), name = expression(-log[10]~italic(P))) +
      scale_x_discrete(drop = FALSE) + scale_y_discrete(drop = FALSE) +
      theme_bw(base_size = 12) +
      theme(panel.grid.major = element_line(color = "grey92", linewidth = 0.3),
            panel.grid.minor = element_blank(),
            panel.border = element_rect(color = "black", fill = NA, linewidth = 0.8),
            axis.text.x = element_text(angle = 45, hjust = 1, color = "black"),
            axis.text.y = element_text(color = "black"),
            axis.ticks = element_line(color = "black"),
            plot.title = element_text(hjust = 0.5, face = "bold")) +
      labs(x = "", y = "", title = paste0(mode, " | ", sex))
    ggsave(outfile, plot = p, width = 6, height = 5, dpi = 300)
    message("已保存: ", outfile)
    invisible(p)
}

