# 2026: 用 {ct}_clean5.h5ad（X = raw counts；列名统一: sex/donor_id/sampleid/age/celltype）
celltypes  = ['AC', 'BC', 'RGC', 'Rod', 'Cone', 'HC', 'MG', 'Microglia', 'RPE']
os.makedirs(out_root, exist_ok=True)

def check_raw_counts(X, name="X", n_check=200000):
    """检查矩阵是否像 raw counts：非负 + 接近整数。返回 (is_raw, msg)。"""
    if sp.issparse(X):
        d = X.data
        if d.size == 0:
            return False, f"{name}: 空矩阵"
        if d.size > n_check:
            rng = np.random.default_rng(0)
            d = d[rng.choice(d.size, n_check, replace=False)]
    else:
        d = np.asarray(X).ravel()
        if d.size > n_check:
            rng = np.random.default_rng(0)
            d = d[rng.choice(d.size, n_check, replace=False)]
    d = d[np.isfinite(d)]
    if d.size == 0:
        return False, f"{name}: 无有效数值"
    mn, mx = float(d.min()), float(d.max())
    frac_nonneg = float(np.mean(d >= -1e-8))
    frac_int = float(np.mean(np.isclose(d, np.round(d), atol=1e-6)))
    is_raw = (frac_nonneg > 0.999) and (frac_int > 0.99) and (mx > 1)
    msg = (f"{name}: min={mn:.4f}, max={mx:.4f}, "
           f"非负比例={frac_nonneg:.4f}, 接近整数比例={frac_int:.4f}, 疑似raw_counts={is_raw}")
    return is_raw, msg

def make_sample_pseudobulk(celltype, h5ad_dir=h5ad_dir, out_root=out_root):
    h5ad_file = os.path.join(h5ad_dir, f"{celltype}_clean5.h5ad")
    print(f"\n==== {celltype} ====")
    assert os.path.exists(h5ad_file), f"找不到 {h5ad_file}"
    adata = sc.read_h5ad(h5ad_file)
    print(f"  {adata.shape[0]} cells x {adata.shape[1]} genes")
    print(f"  obs 列: {adata.obs.columns.tolist()}")
    # clean5: adata.X = raw counts；读入后检查
    is_raw, msg = check_raw_counts(adata.X, name="adata.X")
    print(f"  {msg}")
    if not is_raw:
        raise ValueError(f"{celltype}: adata.X 不像 raw counts，请核对 clean5！")
    counts = adata.X
    if not sp.issparse(counts):
        counts = sp.csr_matrix(counts)
    counts = counts.tocsr()
    #
    obs = adata.obs.copy()
    obs['sampleid'] = obs['sampleid'].astype(str)
    # clean5 的 age 可能是 "90 years" 或数值；统一转成可解析字符串
    obs['age'] = obs['age'].astype(str)
    # donor_id: 主图谱有真实 donor; 若缺失/全空则退回用 sampleid
    if ('donor_id' not in obs.columns) or obs['donor_id'].isna().all():
        obs['donor_id'] = obs['sampleid']
    obs['donor_id'] = obs['donor_id'].astype(str)
    # 按 donor 聚合 (同一供体的多个 sample 合并成一个), 避免伪重复
    donor_ids = sorted(obs['donor_id'].unique().tolist())
    #
    # 按 donor 累加 -> gene x donor
    pb = np.zeros((adata.shape[1], len(donor_ids)), dtype=np.float64)
    meta_rows = []
    for j, did in enumerate(donor_ids):
        idx = np.where((obs['donor_id'] == did).values)[0]
        pb[:, j] = np.asarray(counts[idx, :].sum(axis=0)).flatten()
        sub = obs.iloc[idx]
        age_str = str(sub['age'].iloc[0])
        m = re.search(r'(\d+)', age_str)             # "90 years" / "90" -> 90
        age_num = int(m.group(1)) if m else np.nan
        sex     = sub['sex'].mode().iloc[0] if 'sex' in sub else 'NA'
        n_samp  = sub['sampleid'].nunique()          # 该 donor 合并了几个原始 sample
        meta_rows.append({'donor_id': did, 'donor_age': age_str, 'age': age_num,
                          'sex': sex, 'n_samples': n_samp, 'n_cells': len(idx)})
    meta = pd.DataFrame(meta_rows)
    #
    # 归一化: log2(CP10K + 1) (与 zebrafish/mouse 一致, 用于趋势/可视化)
    lib_sizes = pb.sum(axis=0)                          # 每个 sample 的 library size
    lib_sizes[lib_sizes == 0] = 1                       # 防止除零
    cp10k = pb / lib_sizes * 1e4
    pb_norm = np.log2(cp10k + 1)
    #
    # 导出: matrix_raw.mtx (原始 counts, 给 edgeR) + matrix_norm.mtx (log2-CP10K) + genes.tsv + samples.tsv
    out_dir = os.path.join(out_root, celltype)
    os.makedirs(out_dir, exist_ok=True)
    sio.mmwrite(os.path.join(out_dir, "matrix_raw.mtx"),  sp.csr_matrix(pb))        # 不 normalize, edgeR 用
    sio.mmwrite(os.path.join(out_dir, "matrix_norm.mtx"), sp.csr_matrix(pb_norm))   # log2-CP10K
    pd.Series(adata.var_names).to_csv(os.path.join(out_dir, "genes.tsv"), sep="\t", index=False, header=False)
    meta.to_csv(os.path.join(out_dir, "samples.tsv"), sep="\t", index=False)
    print(f"  donor 数: {len(donor_ids)}; 已保存 raw + norm -> {out_dir}")
    print(meta[['donor_id','age','sex','n_samples','n_cells']].head())
    return meta

# 逐个 celltype 生成
