get_deg_genes <- function(ct){
    g = c()
    for(sx in c("male","female")){
        d = Human_DEGs[[ct]][[sx]]
        if(!is.null(d)) g = c(g, d$Gene[which(d$pvalue < 0.05)])
    }
    unique(g)
}

