###### kmeans (复用斑马鱼的 Kmeans_function) ######
Kmeans_function <- function(Plot, k = 18){
    Plot[Plot > 4]  =  4
    Plot[Plot < -4] = -4
    set.seed(123)
    kc = kmeans(Plot, k, iter.max = 100, nstart = 20)
    data.frame(genes = names(kc$cluster), cluster = as.numeric(kc$cluster))
}
