######
###### noKmeans 重画两张图 (male / female)
###### 边框规则 (同一 ct × category 跨两性比较):
######   - 两性都显著且 NES 同向 → 绿色边
######   - 两性都显著且 NES 反向 → 红色边
######   - 仅一性显著 → 普通灰边 (什么都不做)
###### 主图黑框面板强制正方形 (aspect.ratio = 1)
######

## 若上面对象不在内存，可从文件恢复
if(!exists("Human_GSEA_category_df")){
    Human_GSEA_category_df = read.delim(file.path(out_dir, "Human_GSEA_category.tsv"),
                                        stringsAsFactors = FALSE, check.names = FALSE)
}

df_nk = Human_GSEA_category_df[Human_GSEA_category_df$mode == "noKmeans", , drop = FALSE]
df_nk$neglogP = -log10(pmax(df_nk$pval, 1e-300))
df_nk$sig = !is.na(df_nk$pval) & df_nk$pval < 0.05

## 跨性别比较: 两性都显著的 ct×category
m_sig = df_nk[df_nk$sex == "male"   & df_nk$sig, c("ct","category","NES")]
f_sig = df_nk[df_nk$sex == "female" & df_nk$sig, c("ct","category","NES")]
mf = merge(m_sig, f_sig, by = c("ct","category"), suffixes = c("_m","_f"))
mf$dir = ifelse(sign(mf$NES_m) * sign(mf$NES_f) > 0, "concordant",
         ifelse(sign(mf$NES_m) * sign(mf$NES_f) < 0, "discordant", "other"))
conc_keys = with(mf[mf$dir == "concordant", ], paste(ct, category, sep = "||"))
disc_keys = with(mf[mf$dir == "discordant", ], paste(ct, category, sep = "||"))
key_nk = paste(df_nk$ct, df_nk$category, sep = "||")
df_nk$edge = "single"   # 默认: 仅一性显著 / 未两边都显著
df_nk$edge[key_nk %in% conc_keys] = "concordant"
df_nk$edge[key_nk %in% disc_keys] = "discordant"
df_nk$edge = factor(df_nk$edge, levels = c("single","concordant","discordant"))

message(sprintf("noKmeans 边框: 同向(绿)=%d, 反向(红)=%d (ct×category)",
                length(conc_keys), length(disc_keys)))
if(nrow(mf) > 0) print(mf[, c("ct","category","NES_m","NES_f","dir")])

ct_levels = c("MG","RGC","AC","HC","BC","Cone","Rod","Microglia","RPE")
cat_all   = unique(df_nk$category)
cat_levels = cat_all[order(as.numeric(sub("^C([0-9]+)_.*", "\\1", cat_all)))]
ct_use = ct_levels[ct_levels %in% df_nk$ct]

plot_noKmeans_one_sex <- function(df, sex, outfile){
    plot_df = df[df$sex == sex & df$sig, , drop = FALSE]
    plot_df$category = factor(plot_df$category, levels = rev(cat_levels))
    plot_df$ct       = factor(plot_df$ct, levels = ct_use)

    p = ggplot(plot_df, aes(x = ct, y = category)) +
      geom_point(aes(size = neglogP, fill = NES, color = edge),
                 shape = 21, stroke = 1.2) +
      scale_fill_gradient2(low = "#3C5488", mid = "white", high = "#E64B35",
                           midpoint = 0, name = "NES", limits = c(-3, 3), oob = scales::squish) +
      scale_color_manual(
          values = c(single = "grey30", concordant = "#00A087", discordant = "#E64B35"),
          breaks = c("concordant","discordant"),
          labels = c("both sig, same NES", "both sig, opposite NES"),
          name = "Sex agreement",
          drop = FALSE) +
      scale_size_continuous(range = c(2, 9), name = expression(-log[10]~italic(P))) +
      scale_x_discrete(drop = FALSE) + scale_y_discrete(drop = FALSE) +
      guides(color = guide_legend(override.aes = list(fill = "white", size = 4, stroke = 1.5))) +
      theme_bw(base_size = 12) +
      theme(aspect.ratio = 1,   # 黑框面板正方形
            panel.grid.major = element_line(color = "grey92", linewidth = 0.3),
            panel.grid.minor = element_blank(),
            panel.border = element_rect(color = "black", fill = NA, linewidth = 0.9),
            axis.text.x = element_text(angle = 45, hjust = 1, color = "black"),
            axis.text.y = element_text(color = "black"),
            axis.ticks = element_line(color = "black"),
            plot.title = element_text(hjust = 0.5, face = "bold"),
            legend.position = "right") +
      labs(x = "", y = "", title = paste0("noKmeans | ", sex))
    ggsave(outfile, plot = p, width = 7, height = 7, dpi = 300)
    message("已保存: ", outfile)
    invisible(p)
}

## 单行调用，避免终端粘贴时 + 续行把函数名截断
plot_noKmeans_one_sex(df_nk, "male",   file.path(out_dir, "Human_GSEA_category_bubble_noKmeans_male_edge.png"))
plot_noKmeans_one_sex(df_nk, "female", file.path(out_dir, "Human_GSEA_category_bubble_noKmeans_female_edge.png"))

