###### 读取一个 celltype 的 per-donor pseudobulk ######
## which = "norm" (log2-CP10K, 用于 GAM) 或 "raw" (原始 counts, 用于 edgeR)
read_human_pb <- function(ct, root = pb_root, which = c("norm","raw")){
    which = match.arg(which)
    d     = file.path(root, ct)
    mat   = as.matrix(readMM(file.path(d, paste0("matrix_", which, ".mtx"))))  # gene x donor
    genes = read.table(file.path(d, "genes.tsv"),   sep="\t", header=FALSE, stringsAsFactors=FALSE)[,1]
    meta  = read.table(file.path(d, "samples.tsv"), sep="\t", header=TRUE,  stringsAsFactors=FALSE)
    rownames(mat) = genes
    colnames(mat) = as.character(meta$donor_id)
    list(bulk_mat = mat, bulk_meta = meta)
}

###### 年龄分箱 (不等距, 中点 = 10,25,37.5,50,60,70,80,90; 年轻端更宽以平衡稀疏样本) ######
age_breaks = c(0,20,30,45,55,65,75,85,95)
age_labels = c("10","25","37.5","50","60","70","80","90")

###### 权重: 每个 bin 总权重 ∝ interval 宽度; bin 内除以样本数 (消除样本数不均) ######
## -> 宽 interval (如 0-20) 总话语权更大; 老年样本多也不会主导
make_age_weights <- function(age, breaks = age_breaks){
    bin           = cut(as.numeric(age), breaks = breaks, right = FALSE, include.lowest = TRUE)
    widths        = diff(breaks)                   # 各 interval 宽度
    names(widths) = levels(bin)
    n_per_bin     = table(bin)
    w = widths[as.character(bin)] / as.numeric(n_per_bin[as.character(bin)])
    w[is.na(w)] = mean(w, na.rm = TRUE)            # 落在分箱外的 age 补均值, 防 NA
    as.numeric(w / mean(w))                        # 归一化, 均值=1
}

###### 加权 GAM 平滑 (在原 Smooth_FUN 基础上加 weights, 并做健壮化) ######
Smooth_FUN <- function(x, age, w = NULL){
    vector = as.numeric(scale(as.numeric(x)))
    if(is.null(w)) w = rep(1, length(vector))
    # 常量行 / 全 NA -> 直接返回 p=1
    if(length(unique(vector[!is.na(vector)])) <= 1){
        return(data.frame(age = age, value = vector, predict = vector, p_value = 1))
    }
    df = data.frame(age = age, value = vector, w = w)
    df = df[order(df$age), ]
    rownames(df) = 1:nrow(df)
    # k 自适应: 不能超过 unique 年龄点数
    k_use = min(4, length(unique(df$age)))
    fit = tryCatch(
        gam(value ~ s(age, k = k_use), data = df, weights = df$w, select = TRUE),
        error = function(e) NULL)
    if(is.null(fit)){                          # gam 失败 -> p=1 兜底
        df$predict = df$value; df$p_value = 1; return(df)
    }
    st = summary(fit)$s.table
    df$p_value = if(nrow(st) >= 1) st[1, 4] else 1
    df$predict = predict(fit, newdata = df, type = "response")
    df
}

###### 对一个 (celltype, sex) 子集的 bulk 鉴定 DEGs (加权 GAM) ######
## bulk_list: list(bulk_mat = gene x donor, bulk_meta = data.frame(含 age))
Identify_DEGs <- function(bulk_list, avg_cutoff = 0.01, ncores = 20){
    bulk_mat  = bulk_list$bulk_mat
    bulk_meta = bulk_list$bulk_meta
    stopifnot(identical(colnames(bulk_mat), as.character(bulk_meta$donor_id)))
    # 剔除 age 无法解析的 donor (NA age 会让权重/gam 出错)
    age = suppressWarnings(as.numeric(bulk_meta$age))
    ok  = which(!is.na(age))
    if(length(ok) < length(age)) message("    剔除 ", length(age)-length(ok), " 个 NA age donor")
    bulk_mat = bulk_mat[, ok, drop = FALSE]
    age      = age[ok]
    # 过滤低表达基因
    avg_by_gene = rowMeans(bulk_mat)
    bulk_mat    = bulk_mat[avg_by_gene > avg_cutoff, , drop = FALSE]
    # 逆频权重 (按 age 分箱)
    w = make_age_weights(age)
    # 逐基因加权 GAM
    res_list = mclapply(seq_len(nrow(bulk_mat)),
                        function(i) Smooth_FUN(bulk_mat[i, ], age = age, w = w),
                        mc.cores = ncores)
    # 容错提取: 非 data.frame (try-error) 的基因记 p=1, delta=0
    pvalue = vapply(res_list, function(z) if(is.data.frame(z)) z$p_value[1] else 1, numeric(1))
    delta  = vapply(res_list, function(z) if(is.data.frame(z)) z$predict[nrow(z)] - z$predict[1] else 0, numeric(1))
    res = data.frame(Gene   = rownames(bulk_mat),
                     pvalue = pvalue,
                     FDR    = p.adjust(pvalue, method = "BH"),
                     delta_old_vs_young = delta,
                     stringsAsFactors = FALSE)
    res = res[order(res$pvalue), ]
    res
}

###### 主循环: 每个 celltype x 每个 sex 分别计算 ######
Human_DEGs = list()
for(ct in celltypes){
    message("\n==== ", ct, " ====")
    pb = read_human_pb(ct, which = "norm")
    Human_DEGs[[ct]] = list()
    for(sx in c("male","female")){
        keep = which(tolower(pb$bulk_meta$sex) == sx)
        sub_meta = pb$bulk_meta[keep, , drop = FALSE]
        sub_mat  = pb$bulk_mat[, keep, drop = FALSE]
        n_donor  = length(keep)
        n_bin    = length(unique(cut(as.numeric(sub_meta$age),
                                     breaks = age_breaks,
                                     right = FALSE, include.lowest = TRUE)))
        message("  ", sx, ": ", n_donor, " donors, ", n_bin, " age-bins")
        if(n_donor < 5 || n_bin < 3){
            message("    -> 样本/年龄段太少, 跳过")
            next
        }
        Human_DEGs[[ct]][[sx]] = Identify_DEGs(list(bulk_mat = sub_mat, bulk_meta = sub_meta))
        message("    -> DEGs (pvalue<0.05): ",
                sum(Human_DEGs[[ct]][[sx]]$pvalue < 0.05, na.rm = TRUE))
    }
}

