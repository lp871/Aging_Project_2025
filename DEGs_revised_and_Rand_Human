Build_Rank_from_DEG <- function(deg, eps = 1e-300){
    pv = deg$PValue; pv[is.na(pv)] = 1
    pv[pv < eps] = eps
    stat = sign(deg$logFC) * (-log10(pv))
    names(stat) = deg$Gene
    stat = stat[!is.na(stat)]
    stat = tapply(stat, names(stat), function(x) x[which.max(abs(x))])
    sort(stat, decreasing = TRUE)
}

flatten_rank <- function(rank_nested){
    flat = list()
    for(ct in names(rank_nested))
        for(sx in names(rank_nested[[ct]]))
            flat[[paste(ct, sx, sep = "_")]] = rank_nested[[ct]][[sx]]
    flat
}

