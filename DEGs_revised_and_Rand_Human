flatten_rank_list <- function(x){
    if(length(x) == 0) return(x)
    if(is.numeric(x[[1]])) return(x)                 # 已是扁平: AC_male
    flat = list()
    for(ct in names(x))
        for(sx in names(x[[ct]]))
            flat[[paste(ct, sx, sep = "_")]] = x[[ct]][[sx]]
    flat
