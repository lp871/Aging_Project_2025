bin_of_age <- function(age){
    as.character(cut(as.numeric(age), breaks = age_breaks, labels = age_labels,
                     right = FALSE, include.lowest = TRUE))
}

###### 一个 (celltype, sex) 子集: bin 内各 donor CP10K 取平均, 再 log2(mean+1) -> gene x bin ######
## mat: log2(CP10K+1); 先还原 CP10K = 2^mat - 1
make_bin_avg <- function(mat, meta){
    bin = bin_of_age(meta$age)
    ub  = age_labels[age_labels %in% unique(bin)]          # 只留有数据的 bin, 保持年龄顺序
    cp10k = (2^mat) - 1
    out = sapply(ub, function(b) {
        log2(rowMeans(cp10k[, bin == b, drop = FALSE]) + 1)
    })
    out = as.matrix(out)
    rownames(out) = rownames(mat); colnames(out) = ub
    out
}

