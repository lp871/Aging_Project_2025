Kmeans_function <- function(Plot,k=8){
    ############
    #####
    k_up = which(Plot > 4)
    k_down = which(Plot < -4)
    Plot[k_up] = 4
    Plot[k_down] = -4
    ############
    set.seed(123)
    kc = kmeans(Plot, k, iter.max = 100,nstart=20)
    ####
    kc_dat = data.frame(genes = names(kc$cluster),cluster=as.numeric(kc$cluster))
    #### 
    head(kc_dat)
    ####
    return(kc_dat)
}

