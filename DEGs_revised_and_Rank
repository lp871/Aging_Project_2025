    n = length(Zebrafish_DEG_rank[[ct]])
    n_nz = sum(Zebrafish_DEG_rank[[ct]] != 0)
    pct_nz = 100 * n_nz / max(n, 1)
    message(sprintf("[noKmeans] %s: n=%d, nonzero=%d (%.1f%%); P<0.05 up=%d down=%d",
                    ct, n, n_nz, pct_nz,
                    sum(deg$PValue < 0.05 & deg$logFC > 0, na.rm = TRUE),
                    sum(deg$PValue < 0.05 & deg$logFC < 0, na.rm = TRUE)))
    ## 诊断: 旧 kmeans 清零版 nonzero 通常只有几百/几千且 << n；noKmeans 应接近 100%
