###### rank (与 Mouse / Human noKmeans 一致): 只用 edgeR，不与 Kmeans 取交集 ######
###### metric = sign(logFC) * -log10(PValue)；全部 edgeR 基因直接打分 ######
###### 注意: 旧版会把非 kmeans 基因 P 置 1 → rank≈0；noKmeans 下 nonzero 应接近全部基因数 ######
######
Build_Rank_from_DEG <- function(deg, eps = 1e-300){
    pv = deg$PValue; pv[is.na(pv)] = 1
    pv[pv < eps] = eps
    stat = sign(deg$logFC) * (-log10(pv))
    names(stat) = as.character(deg$Gene)
    ok = !is.na(stat) & is.finite(stat)
    stat = stat[ok]
    stat = tapply(stat, names(stat), function(x) x[which.max(abs(x))])
    sort(stat, decreasing = TRUE)
}

